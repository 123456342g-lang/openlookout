{
  "manifest_version": 3,
  "name": "OpenLookout 记录器",
  "version": "0.1.0",
  "description": "把当前网址和表单填写（只记字段名，不记内容）发给本机的 OpenLookout 记录器。",
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]
}
