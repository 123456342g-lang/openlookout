# Copy to .env and fill in your own key. .env is gitignored.
# A local Ollama server often ignores the token, but the key must still be non-empty.
# Use the placeholder ollama for that case.
SPRITE_API_KEY=PUT-YOUR-KEY-HERE
# Blank follows the Windows display language: zh* -> Chinese, anything else -> English.
# OPENLOOKOUT_LANG=
# Empty means direct HTTP to provider.json. claude and host opt into local Claude Code.
# There is no fallback either way. Unknown values stay on direct.
# OPENLOOKOUT_BACKEND=
# Overrides provider.json "model". Leave blank to use the file.
# OPENLOOKOUT_MODEL=
# HTTP calls per model turn. Default 4, clamped to 1..8.
# OPENLOOKOUT_MAX_CALLS=
